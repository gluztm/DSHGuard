<Application x:Class="DSHGuard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- iOS 风格圆角 -->
            <CornerRadius x:Key="CardRadius">16</CornerRadius>
            <CornerRadius x:Key="BtnRadius">14</CornerRadius>

            <!-- 主色调 (iOS) -->
            <SolidColorBrush x:Key="AccentBlue" Color="#007AFF"/>
            <SolidColorBrush x:Key="AccentCyan" Color="#5AC8FA"/>
            <SolidColorBrush x:Key="AccentGreen" Color="#34C759"/>
            <SolidColorBrush x:Key="AccentOrange" Color="#FF9500"/>
            <SolidColorBrush x:Key="AccentRed" Color="#FF3B30"/>
            <SolidColorBrush x:Key="AccentPurple" Color="#5856D6"/>

            <!-- 暗色背景 -->
            <SolidColorBrush x:Key="BgPrimary" Color="#1A1E2E"/>
            <SolidColorBrush x:Key="BgSecondary" Color="#0D1117"/>
            <SolidColorBrush x:Key="BgCard" Color="#30FFFFFF"/>
            <SolidColorBrush x:Key="BgCardHover" Color="#40FFFFFF"/>

            <!-- 文字 -->
            <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F7"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#8E8E93"/>
            <SolidColorBrush x:Key="TextTertiary" Color="#48484A"/>

            <!-- 状态色 -->
            <SolidColorBrush x:Key="StatusOff" Color="#48484A"/>
            <SolidColorBrush x:Key="StatusStarting" Color="#FF9500"/>
            <SolidColorBrush x:Key="StatusRunning" Color="#34C759"/>
            <SolidColorBrush x:Key="StatusError" Color="#FF3B30"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

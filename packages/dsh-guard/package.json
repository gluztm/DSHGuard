{
  "name": "@gluztm/dsh-guard",
  "version": "2.4.2",
  "description": "Web sidebar & CLI manager for DeepSeek Harness (DSH): toggle plugins and MCP servers with pre-change backups, fix broken node_modules symlinks, check llm-pi-ai providers, write .credentials.yaml keys one-way without plaintext readback, and roll back broken cordis.patch.yml configs.",
  "icon": "./assets/icon.png",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./inspector": "./lib/inspector.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./assets/icon.png"
  },
  "bin": {
    "dsh-guard": "./bin/dsh-guard.mjs"
  },
  "files": [
    "assets",
    "bin",
    "lib",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gluztm/DSHGuard.git",
    "directory": "packages/dsh-guard"
  },
  "homepage": "https://github.com/gluztm/DSHGuard#readme",
  "bugs": {
    "url": "https://github.com/gluztm/DSHGuard/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1 <0.3.0-0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-desktop",
    "dshguard",
    "plugin-manager",
    "mcp-manager",
    "mcp-toggle",
    "cordis-patch-yml",
    "yaml-rollback",
    "config-backup",
    "snapshot-restore",
    "broken-symlink",
    "junction-repair",
    "credentials-yaml",
    "api-key-import",
    "cc-switch",
    "startup-fix",
    "cross-platform"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
